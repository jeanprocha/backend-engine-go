# ─── Obrigatórios ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Connection string do Postgres (Supabase: Project Settings → Database)
DATABASE_URL=

# JWKS do Clerk: Dashboard → API Keys → "JWKS URL" (ou o URL do .well-known/jwks)
# Em dev local pode usar AUTH_SKIP=true e enviar X-User-ID
CLERK_JWKS_URL=
# AUTH_SKIP=true
# (Quando true, o header X-User-ID identifica o utilizador — NÃO use em produção pública)

# ─── CORS (Vercel + browser → Railway) ─────────────────────────────────────
# Origens exatas, separadas por vírgula (inclui https://, sem path final)
# Ex.: https://tribia-app.vercel.app,https://tribia-git-main-xxx.vercel.app
# Com ENV=production, vazio = sem Access-Control-Allow-Origin (CORS duro)
CORS_ALLOWED_ORIGINS=
# ENV=production

# ─── Rede (Railway define PORT automaticamente) ─────────────────────────────
# PORT=8080

# ─── Observabilidade ───────────────────────────────────────────────────────
# LOG_FORMAT=json
# LOG_LEVEL=info
# (Em ENV=production e LOG_FORMAT vazio, o arranque usa JSON)
