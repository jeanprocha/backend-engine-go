# ─── Obrigatórios ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Connection string do Postgres (Supabase: Project Settings → Database)
DATABASE_URL=

# JWKS do Clerk: Dashboard → API Keys → "JWKS URL" (ou o URL do .well-known/jwks)
# Em dev local pode usar AUTH_SKIP=true e enviar X-User-ID
CLERK_JWKS_URL=
# AUTH_SKIP=true
# (Quando true, o header X-User-ID identifica o utilizador — NÃO use em produção pública)

# ─── CORS (Vercel + browser → Railway) ─────────────────────────────────────
# Origens exatas, separadas por vírgula (inclui https://, sem path final)
# Ex.: https://tribia-app.vercel.app,https://tribia-git-main-xxx.vercel.app
# Com ENV=production, vazio = sem Access-Control-Allow-Origin (CORS duro)
CORS_ALLOWED_ORIGINS=
# ENV=production

# ─── Rede (Railway define PORT automaticamente) ─────────────────────────────
# PORT=8080

# ─── Observabilidade ───────────────────────────────────────────────────────
# LOG_FORMAT=json
# LOG_LEVEL=info
# (Em ENV=production e LOG_FORMAT vazio, o arranque usa JSON)

# ─── Corpus legal / PDF oficial (dossiê PDF + ancoragem "Ver lei", Pro/Premium) ──
# URL pública do PDF oficial (QR code no dossiê; CORS deve permitir o domínio do frontend).
# LAW_OFFICIAL_PDF_URL=
# Nome do arquivo, se diferente do documento default (DOC-PLP-682024-20240722.pdf).
# LAW_OFFICIAL_PDF_FILE=
# CSV de article_id — sobrescreve os IDs âncora injetados sempre no contexto da
# classificação (ver internal/classifier/service.go). Trocar junto com a
# re-ingestão de um documento com prefixo novo (ver ingestion.DocumentProfile).
# CLASSIFIER_ANCHOR_ARTICLE_IDS=
# Override de qual documento GET /law/corpus reporta como corrente — sem isto,
# é o de mais chunks ingeridos (ver internal/lawcorpus).
# LAW_CORPUS_CURRENT_SOURCE=
